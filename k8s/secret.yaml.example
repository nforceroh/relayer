apiVersion: v1
kind: Secret
metadata:
  name: relayer-secrets
  namespace: mail
type: Opaque
stringData:
  DB_PASSWORD: "CHANGE_ME"       # relayer_admin's MySQL password
  ADMIN_PASS: "CHANGE_ME_TOO"    # web UI basic auth password
  INGEST_TOKEN: "CHANGE_ME_ALSO" # bearer token the Dovecot pipe script sends
  SECRET_KEY: "CHANGE_ME_TOO_PLEASE"  # Flask session/flash signing key
